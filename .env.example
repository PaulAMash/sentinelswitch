# SentinelSwitch runtime settings (all optional; defaults shown)
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000
# SQLite database rebuilt by `make seed`
SENTINEL_DB=data/generated/sentinelswitch.db
# Seed the database automatically on first start
SENTINEL_AUTO_SEED=1
# Apply the flagship incident automatically on start (used by docker compose)
SENTINEL_AUTO_DEMO=0
# Allowed CORS origins for the Vite dev server
SENTINEL_CORS=http://localhost:5173,http://127.0.0.1:5173
